# =============================================================================
# HealthDecode — environment variables
# =============================================================================
# These are SERVER-side secrets read by the Cloudflare Pages Function
# (functions/api/analyze.ts). They are NEVER exposed to the browser.
#
# LOCAL DEV:  copy this file to ".dev.vars" (NOT .env) so `wrangler pages dev`
#             picks it up:  cp .env.example .dev.vars
# PRODUCTION: set these in Cloudflare dashboard -> Pages project -> Settings ->
#             Environment variables (and mark the key as "encrypted/secret").
# =============================================================================

# Which AI provider to use. Switch this single value to change providers.
#   "gemini"    -> Google Gemini (has a free tier)   [default]
#   "anthropic" -> Anthropic Claude (paid, highest quality)
AI_PROVIDER=gemini

# --- Gemini (free tier) ------------------------------------------------------
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# Optional model override. Default is a fast, free-tier multimodal model.
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic Claude (paid) -------------------------------------------------
# Only needed if AI_PROVIDER=anthropic. Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-key-here
# Optional model override.
ANTHROPIC_MODEL=claude-sonnet-4-6
